    public class ClusterItem
    {
        public double XMean;
        public double Area;
        public int X;
        public int Y;
        public int W;
        public int H;

        public ClusterItem(double xm, double a, int x, int y, int w, int h)
        {
            XMean = xm; Area = a; X = x; Y = y; W = w; H = h;
